---
import Lightbox from './Lightbox.astro';

const pics = [

  {
    title: "Construction",
    image: "/portfolio/construction-1024x640.png",
    thumbnail: "/portfolio/construction-384x240.png",
    alt: "A painting of a worker standing in front of a construction site."
  },

  {
    title: "Dancing Gal",
    image: "/portfolio/dancing-gal-794x1124.png",
    thumbnail: "/portfolio/dancing-gal-272x384.png",
    alt: "A painting of a woman dancing in a pink top."
  },

  {
    title: "Dancing Together",
    image: "/portfolio/dancing-together-1124x794.png",
    thumbnail: "/portfolio/dancing-together-384x272.png",
    alt: "A painting of three people dancing under a glitterball."
  },

  {
    title: "Grow From Within",
    image: "/portfolio/grow-from-within-1124x794.png",
    thumbnail: "/portfolio/grow-from-within-384x272.png",
    alt: "A painting of a woman with a watering can next to a greenhouse."
  },

  {
    title: "Make Some Music",
    image: "/portfolio/make-some-music-1124x794.png",
    thumbnail: "/portfolio/make-some-music-384x272.png",
    alt: "A painting of a trumpet player and a double bass player."
  },

  {
    title: "Mother Nature",
    image: "/portfolio/mother-nature-794x1124.png",
    thumbnail: "/portfolio/mother-nature-272x384.png",
    alt: "A painting of a female figure embracing the world's plant life."
  },

]
---

<section
  id="work"
  class="bg-teal-50 px-6 py-20 lg:px-8 lg:py-28"
  aria-labelledby="work-title"
>

  <div class="mx-auto max-w-7xl">

    <!-- Heading -->
    <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">

      <div>
        <p class="font-bold uppercase tracking-[0.2em] text-orange-500">A little colour</p>
        <h2 id="work-title" class="mt-2 text-5xl sm:text-6xl font-display tracking-tight text-teal-700 rotate-[-2deg]">Featured Work</h2>
        <div class="mt-5 h-2 w-60 w-80 rotate-[-2deg] rounded-full bg-pink-400"></div>
      </div>

      <a href="/gallery" class="font-bold text-teal-700 transition hover:text-orange-500">View more work<span aria-hidden="true">→</span></a>

    </div>


    <div class="gallery">

      {pics.map((pic) => (

        <div>

          <a
            href={pic.image}
            class="glightbox"
            data-gallery="portfolio"
            data-title={pic.title}
            data-description={pic.alt}
          >
            <img
              src={pic.thumbnail}
              alt={pic.alt}
            />
          </a>

          <h3>{pic.title}</h3>

        </div>

      ))}

    </div>

    <Lightbox />


  </div>

</section>

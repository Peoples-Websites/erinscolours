---
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import CommunityCTA from "../components/CommunityCTA.astro";

import "../styles/global.css";
---

<!doctype html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Erin's Colours | Community Artist</title>

    <meta
      name="description"
      content="Erin Nicholson is a community artist creating colourful, joyful artwork and bringing people together through creativity."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&display=swap" rel="stylesheet">

  </head>

  <body class="bg-stone-50 text-slate-900 antialiased">

    <!-- Navigation -->
    <header
      class="sticky top-0 z-50 border-b border-teal-900/10 bg-stone-50/95 backdrop-blur"
    >
      <nav
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
        aria-label="Main navigation"
      >
        <a
          href="/"
          class="text-2xl font-black tracking-tight text-teal-700"
          aria-label="Erin's Colours home"
        >
          Erin's <span class="text-orange-500">Colours</span>
        </a>

        <div class="hidden items-center gap-8 md:flex">
          <a
            href="/"
            class="font-semibold text-teal-700 transition hover:text-orange-500"
          >
            Home
          </a>

          <a
            href="#about"
            class="font-semibold text-slate-700 transition hover:text-orange-500"
          >
            About
          </a>

          <a
            href="#community"
            class="font-semibold text-slate-700 transition hover:text-orange-500"
          >
            Community
          </a>

          <a
            href="#work"
            class="font-semibold text-slate-700 transition hover:text-orange-500"
          >
            Gallery
          </a>

          <a
            href="#contact"
            class="font-semibold text-slate-700 transition hover:text-orange-500"
          >
            Contact
          </a>
        </div>

        <!-- Simple mobile menu link -->
        <a
          href="#work"
          class="rounded-full bg-teal-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-teal-800 md:hidden"
        >
          Gallery
        </a>
      </nav>
    </header>

    <main>
      <Hero />
      <About />
      <FeaturedWork />
      <CommunityCTA />
    </main>

    <!-- Footer -->
    <footer
      id="contact"
      class="bg-teal-900 px-6 py-10 text-white lg:px-8"
    >
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 md:flex-row"
      >
        <div>
          <p class="text-2xl font-black">
            Erin's <span class="text-yellow-300">Colours</span>
          </p>

          <p class="mt-1 text-sm text-teal-100">
            Art. People. Brighter Together.
          </p>
        </div>

        <div class="flex gap-6 text-sm font-semibold">
          <a
            href="#"
            class="transition hover:text-yellow-300"
            aria-label="Instagram"
          >
            Instagram
          </a>

          <a
            href="#"
            class="transition hover:text-yellow-300"
            aria-label="Facebook"
          >
            Facebook
          </a>

          <a
            href="mailto:"
            class="transition hover:text-yellow-300"
          >
            Email
          </a>
        </div>

        <p class="text-sm text-teal-200">
          © {new Date().getFullYear()} Erin Nicholson
        </p>
      </div>
    </footer>

  </body>

</html>

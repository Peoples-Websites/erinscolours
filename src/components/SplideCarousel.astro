---
import "@splidejs/splide/css"
import { Splide, SplideSlide } from 'astro-splide';

import "../styles/splide.css";
---

<!-- not-content is used because this is using astro starlight
     - without it, the 3 dots in the sliders are not aligned -->
<!-- check for options at https://splidejs.com/guides/options/ -->

<Splide class = "not-content"
  options = {
    {
      type: "loop",
      perPage: 1,
      perMove: 1,
      heightRatio: 1.0,
      autoplay: true,
      interval: 4000,
      speed: 1000,
      pauseOnHover: true,
      mediaQuery: "min",
      breakpoints: {
        640: {
          perPage: 3,
          heightRatio: 0.33,
        },
      }
    }
  }
>
  <SplideSlide>
    <div class="card">
      <a href="/posts-events/2025/post-001">
        <img class="carousel-img crop-center" src="/pics/2025/bradford-2025-walls-morrisons-mural.jpeg" alt="" style="width: 100%" />
        <div class="details">
          <h2>Serving the District</h2>
          <h3>Event</h3>
          <h4>2025</h4>
        </div>
      </a>
    </div>
